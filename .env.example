# ============================================================
# A.N.I.T.A. 快速部署配置文件
# 必填项：仅需填写您自己的 DeepSeek API 密钥
# ============================================================
DEEPSEEK_API_KEY=sk-请在此处填入您的DeepSeek_API_KEY

# ============================================================
# 以下参数均已预设最优默认值，无需修改即可直接运行
# ============================================================
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# JWT 会话安全密钥（可按需自定义更换）
JWT_SECRET=f8b1c4e92a73d56e01a8f93c72e50d8b4c3e21a95f70b68d123e4a5c9b7e012f

# 本地记忆向量缓存上限
EMBEDDING_CACHE_SIZE=200